<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#F57C00</color>
    <color name="bg_light">#F5F6FA</color>
    <color name="divider">#E0E0E0</color>
    <color name="green_700">#2E7D32</color>
    <color name="green_light">#E8F5E9</color>
    <color name="primary">#1565C0</color>
    <color name="primary_dark">#0D47A1</color>
    <color name="red_700">#C62828</color>
    <color name="red_light">#FFEBEE</color>
    <color name="text_primary">#212121</color>
    <color name="text_secondary">#757575</color>
    <string name="app_name">Utang Tracker</string>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_light</item>
    </style>
    <style name="SplashTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>